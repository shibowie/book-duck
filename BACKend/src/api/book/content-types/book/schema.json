{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "book"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "author": {
      "type": "string",
      "required": true
    },
    "pageCount": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "publicationDate": {
      "type": "date",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "ratings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::rating.rating",
      "mappedBy": "book"
    },
    "book_list_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book-list-item.book-list-item",
      "mappedBy": "book"
    },
    "description": {
      "type": "string",
      "default": "🕮 This is a book about something ☕︎",
      "maxLength": 250
    },
    "genre": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Thriller / Suspense",
        "Drama",
        "Childrens",
        "Fantasy",
        "Science Fiction",
        "True Crime",
        "Romance",
        "Autobiography",
        "History",
        "Horror",
        "Young Adult",
        "Mystery / Crime"
      ]
    }
  }
}
